@model CurrencyX.Models.CurrencyConversionModel

@{
    ViewData["Title"] = "Currency Converter";
}

<div class="container mt-4">

    <h1>Currency Converter</h1>

    <form asp-controller="Home"
          asp-action="Index"
          method="post">

        <div class="mb-3">
            <label asp-for="Amount" class="form-label">
                Amount
            </label>

            <input asp-for="Amount"
                   class="form-control"
                   placeholder="Enter amount" />

            <span asp-validation-for="Amount"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <button type="button"
                    id="swapButton"
                    class="btn btn-secondary mb-3">
                ⇄ Swap Currencies
            </button>
            <label asp-for="FromCurrency" class="form-label">
                From Currency
            </label>

            <select asp-for="FromCurrency"
                    class="form-select">

                <option value="USD">USD</option>
                <option value="INR">INR</option>
                <option value="EUR">EUR</option>
                <option value="GBP">GBP</option>
                <option value="JPY">JPY</option>

            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ToCurrency" class="form-label">
                To Currency
            </label>

            <select asp-for="ToCurrency"
                    class="form-select">

                <option value="INR">INR</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="GBP">GBP</option>
                <option value="JPY  ">JPY</option>

            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Convert
        </button>

    </form>

    @if (Model.IsConverted)
    {
        <div class="alert alert-success mt-4">

            <h4>Conversion Result</h4>

            <p>
                @Model.Amount @Model.FromCurrency =
                <strong>
                    @Model.Result.ToString("N2")
                    @Model.ToCurrency
                </strong>
            </p>

            <p>
                <strong>Converted on:</strong>
                @Model.ConversionTime.ToString("dd MMMM yyyy, hh:mm tt")
            </p>

        </div>
    }

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}